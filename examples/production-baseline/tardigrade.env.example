# Production-hardened baseline — fill in real values before deploying.
# Copy this file, replace all placeholder values, and source it in your
# service unit's EnvironmentFile= directive.
#
# Never commit the live copy of this file to version control.

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8443

# ── TLS ───────────────────────────────────────────────────────────────────────

# Full certificate chain (leaf + intermediate CA certificates).
TARDIGRADE_TLS_CERT_PATH=/etc/tardigrade/tls/fullchain.pem
# Private key matching the leaf certificate.
TARDIGRADE_TLS_KEY_PATH=/etc/tardigrade/tls/privkey.pem
# Minimum TLS version. 1.2 is the floor; 1.3-only gives a stricter posture.
TARDIGRADE_TLS_MIN_VERSION=1.2

# ── Security headers ──────────────────────────────────────────────────────────

# Emit standard security headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, etc.) on every response.
TARDIGRADE_SECURITY_HEADERS=true

# HSTS: tell browsers to always use HTTPS for this origin.
# Enable once TLS is confirmed working — disabling it later is hard.
TARDIGRADE_HSTS_ENABLED=true
TARDIGRADE_HSTS_MAX_AGE=31536000
TARDIGRADE_HSTS_INCLUDE_SUBDOMAINS=true
# Set TARDIGRADE_HSTS_PRELOAD=true only after submitting to the HSTS preload list.
#TARDIGRADE_HSTS_PRELOAD=false

# ── Upstream ─────────────────────────────────────────────────────────────────

TARDIGRADE_UPSTREAM_BASE_URL=http://127.0.0.1:8080

# Active health probing — remove unhealthy backends from rotation.
TARDIGRADE_UPSTREAM_PROBE_PATH=/
TARDIGRADE_UPSTREAM_PROBE_INTERVAL_MS=5000
TARDIGRADE_UPSTREAM_PROBE_TIMEOUT_MS=2000
TARDIGRADE_UPSTREAM_PROBE_FAIL_THRESHOLD=3
TARDIGRADE_UPSTREAM_ACTIVE_PROBE_SUCCESS_THRESHOLD=2

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Adjust to your expected traffic profile. Start conservative.
TARDIGRADE_RATE_LIMIT_RPS=100
TARDIGRADE_RATE_LIMIT_BURST=30

# ── Access logs ───────────────────────────────────────────────────────────────

TARDIGRADE_ACCESS_LOG_FORMAT=json
# Buffer writes for throughput; keep 0 if using journald to avoid double-buffering.
TARDIGRADE_ACCESS_LOG_BUFFER_SIZE=65536

# ── Metrics ───────────────────────────────────────────────────────────────────

TARDIGRADE_METRICS_PATH=/status/metrics
# Restrict metric scraping to internal scrapers — enable auth or firewall this path.
#TARDIGRADE_METRICS_REQUIRE_AUTH=false

# ── Process management ────────────────────────────────────────────────────────

# Under the packaged systemd unit (packaging/systemd/tardigrade.service),
# ExecStart pins TARDIGRADE_PID_FILE to /run/tardigrade/tardigrade.pid at
# exec time regardless of this file's value, so ExecReload/ExecStop always
# target the process the unit actually started. This value only takes
# effect for standalone/manual runs outside that unit (e.g. this file's own
# "Quick start" instructions below, run as a local user) — point it at a
# path your current user can write, and keep it consistent with whatever
# `--pid-file` you pass to `tardi reload`/`tardi stop` in that case.
TARDIGRADE_PID_FILE=/tmp/tardigrade.pid

# ── Graceful shutdown ─────────────────────────────────────────────────────────

# Match TimeoutStopSec in the systemd unit, plus a few seconds of headroom.
TARDIGRADE_SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# ── Timeouts ─────────────────────────────────────────────────────────────────

# TLS handshake: protects against clients that stall the handshake.
TARDIGRADE_TLS_HANDSHAKE_TIMEOUT_MS=5000
# Header read: bounds slowloris and header-drip attacks.
TARDIGRADE_HEADER_TIMEOUT_MS=10000
# Body read: limits unbounded body uploads before proxying.
TARDIGRADE_BODY_TIMEOUT_MS=30000

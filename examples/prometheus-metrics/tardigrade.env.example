# Prometheus metrics example — replace values before production use.

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8080

# ── Upstream ─────────────────────────────────────────────────────────────────

TARDIGRADE_UPSTREAM_BASE_URL=http://127.0.0.1:8081

# ── Prometheus metrics ────────────────────────────────────────────────────────

# Path where Prometheus metrics are served. Default: /status/metrics.
# Set to empty string to disable the endpoint entirely.
TARDIGRADE_METRICS_PATH=/status/metrics

# Require auth before serving the metrics endpoint. Default: false.
# Enable this in production to prevent metric scraping by untrusted clients.
#TARDIGRADE_METRICS_REQUIRE_AUTH=false

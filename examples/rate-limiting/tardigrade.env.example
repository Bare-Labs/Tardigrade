# Rate limiting example — replace values before production use.

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8080

# ── Upstream ─────────────────────────────────────────────────────────────────

TARDIGRADE_UPSTREAM_BASE_URL=http://127.0.0.1:8081

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Sustained request ceiling in requests per second. Set to 0 to disable.
# Clients that exceed this limit receive 429 Too Many Requests.
TARDIGRADE_RATE_LIMIT_RPS=60

# Burst headroom above the RPS ceiling. Allows short request spikes without
# immediately returning 429.
TARDIGRADE_RATE_LIMIT_BURST=20

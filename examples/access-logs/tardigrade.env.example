# Access logs example — replace values before production use.

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8080

# ── Upstream ─────────────────────────────────────────────────────────────────

TARDIGRADE_UPSTREAM_BASE_URL=http://127.0.0.1:8081

# ── Access logs ───────────────────────────────────────────────────────────────

# Log format. Options: json (default), plain, custom.
# json: one JSON object per line, suitable for log shippers (Fluent Bit, Vector, etc.).
# plain: human-readable text.
# custom: use TARDIGRADE_ACCESS_LOG_TEMPLATE to define your own format.
TARDIGRADE_ACCESS_LOG_FORMAT=json

# Only emit log lines for responses at or above this HTTP status code.
# 0 (default) logs every request. 400 logs only errors.
TARDIGRADE_ACCESS_LOG_MIN_STATUS=400

# Buffer log writes in batches of this many bytes before flushing to stdout.
# 0 (default) disables buffering (unbuffered, suitable for systemd journald).
#TARDIGRADE_ACCESS_LOG_BUFFER_SIZE=65536

# Forward access logs to a syslog UDP endpoint in addition to stdout.
# Format: "host:port". Leave empty (default) to disable.
#TARDIGRADE_ACCESS_LOG_SYSLOG_UDP=127.0.0.1:514

# Custom log template (only used when TARDIGRADE_ACCESS_LOG_FORMAT=custom).
# Available placeholders: $remote_addr, $method, $uri, $status, $bytes_sent,
# $request_time_ms, $request_id, $upstream_addr.
#TARDIGRADE_ACCESS_LOG_TEMPLATE=$remote_addr - $method $uri → $status ($request_time_ms ms)

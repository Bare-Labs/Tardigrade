# Health checks example — replace values before production use.
# Copy this file and fill in real upstream URLs.

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8080

# ── Upstreams ─────────────────────────────────────────────────────────────────

# Comma-separated list of upstream base URLs for pool load balancing.
# When more than one URL is given, Tardigrade distributes requests across
# all healthy backends.
TARDIGRADE_UPSTREAM_BASE_URLS=http://127.0.0.1:3001,http://127.0.0.1:3002

# ── Active health checks ──────────────────────────────────────────────────────

# Path probed on each upstream to determine liveness. An HTTP 2xx response
# marks the backend as healthy; any other response or a connection error
# marks it as unhealthy and removes it from rotation until it recovers.
TARDIGRADE_UPSTREAM_PROBE_PATH=/health

# Interval between probes, in milliseconds. 0 disables active checking (default).
TARDIGRADE_UPSTREAM_PROBE_INTERVAL_MS=5000

# Timeout for a single probe, in milliseconds. Default: 2000 (2 s).
#TARDIGRADE_UPSTREAM_PROBE_TIMEOUT_MS=2000

# Consecutive failures required to mark a backend unhealthy. Default: 1.
#TARDIGRADE_UPSTREAM_PROBE_FAIL_THRESHOLD=3

# Consecutive successes required to restore a backend to healthy. Default: 1.
#TARDIGRADE_UPSTREAM_ACTIVE_PROBE_SUCCESS_THRESHOLD=2

# HTTP status range considered a healthy probe response. Default: 200-299.
#TARDIGRADE_UPSTREAM_PROBE_SUCCESS_STATUS=200-299

# ── Load balancing ────────────────────────────────────────────────────────────

# Algorithm used to distribute requests across the pool.
# Options: round_robin (default), least_connections, ip_hash, random_two_choices.
#TARDIGRADE_UPSTREAM_LB_ALGORITHM=round_robin

# TLS termination example — replace values before production use.
# Copy this file and fill in real cert/key paths.
#
# Usage:
#   set -a && source tardigrade.env.example && set +a
#   TARDIGRADE_CONFIG_PATH=examples/tls-termination/tardigrade.conf ./zig-out/bin/tardi

# ── Network ───────────────────────────────────────────────────────────────────

TARDIGRADE_LISTEN_HOST=0.0.0.0
TARDIGRADE_LISTEN_PORT=8443

# ── TLS ───────────────────────────────────────────────────────────────────────

# Replace with real certificate and private key paths.
# The cert file must contain the full chain (leaf + intermediates).
TARDIGRADE_TLS_CERT_PATH=/etc/tardigrade/tls/fullchain.pem
TARDIGRADE_TLS_KEY_PATH=/etc/tardigrade/tls/privkey.pem

# Minimum TLS version. 1.2 is the recommended floor; 1.3-only is stricter.
#TARDIGRADE_TLS_MIN_VERSION=1.2

# ── Upstream ─────────────────────────────────────────────────────────────────

# Backend application; must be reachable from this host.
TARDIGRADE_UPSTREAM_BASE_URL=http://127.0.0.1:8080

# ── Timeouts ─────────────────────────────────────────────────────────────────

# TLS handshake deadline. Adjust for high-latency clients.
#TARDIGRADE_TLS_HANDSHAKE_TIMEOUT_MS=5000

# Header read deadline. Protects against slowloris.
#TARDIGRADE_HEADER_TIMEOUT_MS=10000

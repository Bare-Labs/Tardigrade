pid __PID_FILE__;
listen __LISTEN_PORT__ ssl;
server_name __TLS_SERVER_NAME__;
tls_cert_path __TLS_CERT_PATH__;
tls_key_path __TLS_KEY_PATH__;
metrics_path /status/metrics;
root __STATIC_ROOT__;
try_files $uri;

location = /health {
    return 200 ok;
}

location = /tiny.txt {
    root __STATIC_ROOT__;
    try_files $uri;
}

location = /large.bin {
    root __STATIC_ROOT__;
    try_files $uri;
}

location /proxy/ {
    proxy_pass http://127.0.0.1:__UPSTREAM_PORT__/;
}

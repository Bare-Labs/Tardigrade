global
    master-worker
    pidfile __PID_FILE__
    maxconn 4096
    log stdout format raw local0 warning

defaults
    mode http
    option httplog
    option http-keep-alive
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend tardigrade_competitive
    bind 127.0.0.1:__LISTEN_PORT__
    http-request return status 200 content-type text/plain string ok if { path -i /health }
    http-request return status 200 content-type text/plain file __STATIC_ROOT__/tiny.txt if { path -i /tiny.txt }
    # HAProxy evaluates all http-request rules before any use_backend rule
    # regardless of their textual order (it warns about this at parse time),
    # so an unconditional 404 fallback placed after use_backend still runs
    # first and swallows every /proxy/* request before routing sees it. Scope
    # the fallback to non-proxy paths so use_backend actually gets a turn.
    http-request return status 404 content-type text/plain string not-found unless { path_beg /proxy/ }
    use_backend origin if { path_beg /proxy/ }

backend origin
    http-reuse always
    http-request replace-path ^/proxy/(.*)$ /\1
    server origin1 127.0.0.1:__UPSTREAM_PORT__ check
